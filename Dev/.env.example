# Browser-visible JavaScript key. Register http://127.0.0.1:5173 in the Kakao console.
VITE_KAKAO_JS_KEY=
# Server-only REST key. Never prefix this value with VITE_.
KAKAO_REST_API_KEY=
KAKAO_MOBILITY_REST_API_KEY=
# Optional. Defaults to facilities.sqlite3 in Dev.
FIND_NEARBY_DB=
FIND_NEARBY_DAILY_LIMIT=300
FIND_NEARBY_MINUTE_LIMIT=50
FIND_NEARBY_SEARCH_CALLS=12
FIND_NEARBY_SEARCH_SECONDS=8
# Share this SQLite path between workers of the same deployment.
FIND_NEARBY_USAGE_DB=
